ninja_required_version = 1.3
cxx = ccache c++

cflags = -DTORCH_EXTENSION_NAME=exllamav3_ext -DTORCH_API_INCLUDE_EXTENSION_H -I/home/daniel/development/gunzi/local-llm/opt-cpu-bf16/exllamav3/exllamav3_ext -I/home/daniel/development/gunzi/local-llm/opt-cpu-bf16/exllamav3/exllamav3_ext/cpu_compat -isystem /home/daniel/development/gunzi/local-llm/cpu-trial/.venv/lib/python3.13/site-packages/torch/include -isystem /home/daniel/development/gunzi/local-llm/cpu-trial/.venv/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /home/daniel/.local/share/uv/python/cpython-3.13.11-linux-x86_64-gnu/include/python3.13 -fPIC -std=c++20 -O3
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/daniel/development/gunzi/local-llm/cpu-trial/.venv/lib/python3.13/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build cuda_stub.o: compile /home/daniel/development/gunzi/local-llm/opt-cpu-bf16/exllamav3/exllamav3_ext/cpu_compat/cuda_stub.cpp
